# Ollama
OLLAMA_HOST=http://ollama:11434

# Proxy
PROXY_PORT=11435

# TurboQuant
TQ_BITS=3
TQ_GROUP_SIZE=64
TQ_RESIDUAL=true
TQ_MOE_ENABLED=true
TQ_GPU_CACHE_EXPERTS=4
TQ_MAX_SEQ_LEN=32768
TQ_PREFETCH_DEPTH=2

# Monitoring
GRAFANA_PASSWORD=changeme_in_production

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
