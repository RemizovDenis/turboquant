# TurboQuant Environment Configuration
# Copy to .env and adjust values for your deployment.

# ---- Ollama ----
OLLAMA_HOST=http://ollama:11434

# ---- TurboQuant Proxy ----
PROXY_PORT=11435
TQ_BITS=3
TQ_GROUP_SIZE=64
TQ_RESIDUAL=true
TQ_MAX_SEQ_LEN=32768

# ---- Grafana ----
GRAFANA_USER=admin
GRAFANA_PASSWORD=turboquant

# ---- Logging ----
LOG_LEVEL=info
LOG_FORMAT=json
