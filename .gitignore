# --- TurboQuant-MoE .gitignore ---

# Virtual environments (must be ignored)
.venv/
venv/
env/
ENV/

# Python bytecode/cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.nox/
.tox/

# Project results & artifacts
results/*.html
benchmark_results/*.html
*.safetensors
*.onnx
*.log
*.json
!benchmark_ultimate_m4.json
!pyproject.toml
!prometheus.yml
!.env.example

# Environment & local settings
.env
.DS_Store
.vscode/
.idea/
*.swp
*.swo

# Build & distribution
build/
dist/
*.egg-info/
*.egg

# Docker
.docker/
docker-compose.override.yml

# OS-specific
Thumbs.db
Desktop.ini
v030_fix/
v030_ci_fix/
.venv_final/
AUDIT_RESULTS.md
